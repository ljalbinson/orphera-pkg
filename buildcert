#!/bin/bash
# Issues a new wildcard server certificate and key, signed by the existing CA
# in certs/ (ca.crt + ca.key). Use `make certs DOMAIN=...` to create the CA.
#
# Usage: ./buildcert [domain]        (default: ljalbinson.com)
#
# The new key and certificate are written to temporary files and moved into
# place only once the certificate has been signed and checked, so a failure
# leaves the existing server.crt / server.key untouched and still a pair.
[ -n "${BASH_VERSION:-}" ] || exec bash "$0" "$@"   # also when run as `sh buildcert`
set -euo pipefail

DOMAIN="${1:-ljalbinson.com}"
cd "$(dirname "$0")/certs"

for f in ca.crt ca.key; do
  [ -f "$f" ] || { echo "certs/$f not found; run: make certs DOMAIN=$DOMAIN" >&2; exit 1; }
done

modulus() { openssl "$1" -noout -modulus -in "$2" | openssl md5; }
if [ "$(modulus x509 ca.crt)" != "$(modulus rsa ca.key)" ]; then
  echo "certs/ca.crt and certs/ca.key do not match; nothing changed." >&2
  echo "Replacing the CA means every agent needs a new package: see 'make certs-clean'." >&2
  exit 1
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
SAN="subjectAltName=DNS:*.${DOMAIN},DNS:localhost,IP:127.0.0.1"
printf '%s\n' "$SAN" > "$tmp/ext"

openssl req -newkey rsa:4096 -nodes -keyout "$tmp/server.key" -out "$tmp/server.csr" \
  -subj "/CN=*.${DOMAIN}" -addext "$SAN" 2>/dev/null
openssl x509 -req -in "$tmp/server.csr" -CA ca.crt -CAkey ca.key -CAcreateserial \
  -out "$tmp/server.crt" -days 3650 -extfile "$tmp/ext"

openssl verify -CAfile ca.crt "$tmp/server.crt" >/dev/null
[ "$(modulus x509 "$tmp/server.crt")" = "$(modulus rsa "$tmp/server.key")" ]

chmod 600 "$tmp/server.key"
mv "$tmp/server.key" server.key
mv "$tmp/server.crt" server.crt
rm -f server.csr
echo "Issued certs/server.crt for *.${DOMAIN}, signed by certs/ca.crt."
echo "Rebuild the agent package (make deb) and redeploy it to every node."
