# RPM spec for the orphera command line, filled in and built by `make cli-rpm` from the same
# staged tree as the .deb (pkg-cli). The tree is copied in from the stagedir macro.
Name:           orphera
Version:        %{version}
Release:        1
Summary:        Orphera orchestration command line
License:        Apache-2.0
BuildArch:      noarch
Requires:       java-headless
Recommends:     python3-pyyaml
AutoReqProv:    no
# The jars are already compressed, and the tree has jars and scripts, not ELF files.
%global __os_install_post %{nil}

%description
The orphera command, its playbooks (manifests) and helper scripts. Installs in
/usr/bin, /usr/lib/orphera and /usr/share/orphera; the inventory, per-VM configs and the
certificate authority belong in ~/.config/orphera (or /etc/orphera).

%prep

%build

%install
mkdir -p %{buildroot}
cp -a %{stagedir}/. %{buildroot}/
rm -rf %{buildroot}/DEBIAN

%files
%defattr(-,root,root,-)
/usr/bin/orphera
/usr/bin/vmctl
/usr/bin/start-vm
/usr/bin/stop-vm
/usr/bin/reboot-vm
/usr/bin/list-vms
/usr/bin/move-vm
/usr/bin/galera-cold-start
/usr/bin/scan-vm-sizes
/usr/bin/vbmc-vm
/usr/lib/orphera
/usr/share/orphera
/usr/share/doc/orphera
/usr/share/bash-completion/completions/orphera
%dir /etc/orphera
%dir /etc/orphera/config
%dir /etc/orphera/certs
