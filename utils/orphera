#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Runs the orchestrator directly from its assembled jar.
#
# Where it runs from, in order: $ORPHERA_HOME (which must exist), else
# ~/orphera-pkg if that directory exists, else the current directory. Relative
# paths (inventory.yaml, config/, manifests/, certs/, .orphera-*) are relative to
# that directory, so a machine with no checkout can keep them anywhere and
# say so with -I, -c, -m, ORPHERA_CERTS_DIR and ORPHERA_STATE_DIR.
#
# Usage: orphera <command> [args...]
# e.g.:  orphera version --nodes tst0
#        orphera reboot --wait

set -e

if [ -n "${ORPHERA_HOME:-}" ]; then
  if [ ! -d "$ORPHERA_HOME" ]; then
    echo "Error: ORPHERA_HOME is $ORPHERA_HOME, which is not a directory" >&2
    exit 1
  fi
  cd "$ORPHERA_HOME"
elif [ -d "$HOME/orphera-pkg" ]; then
  cd "$HOME/orphera-pkg"
fi

# `make orpheracli` installs the orchestrator under this fixed name. Older
# installs left versioned jars here and the newest-sorting one was used, so a
# stray higher-numbered jar silently won over a fresh build.
JAR=/usr/local/lib/orphera-orchestrator.jar

if [ ! -f "$JAR" ]; then
  JAR=$(ls orchestrator/target/scala-*/orchestrator-assembly-*.jar 2>/dev/null | sort -V | tail -1)
  if [ -z "$JAR" ]; then
    echo "No orchestrator jar installed. Run 'make orpheracli' in the Orphera repository." >&2
    exit 1
  fi
  echo "Note: using $JAR from the build tree; run 'make orpheracli' to install it." >&2
fi

exec java -cp "$JAR" orphera.orchestrator.Main "$@"
