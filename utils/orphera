#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Runs the orchestrator directly from its assembled jar.
#
# Looks for the Orphera repo at $ORPHERA_HOME, defaulting to
# ~/orphera-pkg if unset. Override with:
#   export ORPHERA_HOME=/path/to/orphera-pkg
#
# Usage: orphera <command> [args...]
# e.g.:  orphera version --nodes tst0
#        orphera reboot --wait

set -e

REPO_DIR="${ORPHERA_HOME:-$HOME/orphera-pkg}"

if [ ! -d "$REPO_DIR" ]; then
  echo "Error: Orphera repo not found at $REPO_DIR" >&2
  echo "Set ORPHERA_HOME to the correct path, e.g.:" >&2
  echo "  export ORPHERA_HOME=/path/to/orphera-pkg" >&2
  exit 1
fi

cd "$REPO_DIR"

# `make orpheracli` installs the orchestrator under this fixed name. Older
# installs left versioned jars here and the newest-sorting one was used, so a
# stray higher-numbered jar silently won over a fresh build.
JAR=/usr/local/lib/orphera-orchestrator.jar

if [ ! -f "$JAR" ]; then
  JAR=$(ls orchestrator/target/scala-*/orchestrator-assembly-*.jar 2>/dev/null | sort -V | tail -1)
  if [ -z "$JAR" ]; then
    echo "No orchestrator jar installed. Run 'make orpheracli' in $REPO_DIR." >&2
    exit 1
  fi
  echo "Note: using $JAR from the build tree; run 'make orpheracli' to install it." >&2
fi

exec java -cp "$JAR" orphera.orchestrator.Main "$@"
